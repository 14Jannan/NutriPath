{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "Provider": "Groq",
    "Multilingual": {
      "Enabled": true,
      "SupportedLanguages": [ "en", "ta", "si" ],
      "DefaultLanguage": "en"
    }
  },
  "Gemini": {
    "Model": "gemini-3.5-flash-lite",
    "ThinkingLevel": "low",
    "MaxOutputTokens": 1024,
    "TimeoutSeconds": 30,
    "MaxAttempts": 3,
    "MaxRetryDelaySeconds": 8,
    "FreeTier": true,
    "RealUserDataApproved": false,
    "SyntheticUserEmailDomains": [ "nutripath.test" ]
  }
}
